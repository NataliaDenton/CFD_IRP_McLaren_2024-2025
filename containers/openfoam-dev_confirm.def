#
# OpenFOAM 2406 container with Python venv on Ubuntu 22.04
#
# Example:
#   apptainer build --fakeroot openfoam_dev_2406.sif openfoam-dev.def
#
# ---------------------------------------------------------------------------
Bootstrap: docker
From: ubuntu:22.04

%files
    openfoam-files.rc/* /openfoam/
    requirements.txt /openfoam/requirements.txt

%post
    DEBIAN_FRONTEND=noninteractive

    echo "🔹 Updating APT sources..."
    apt-get update

    echo "🔹 Installing system dependencies..."
    apt-get -y install --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        apt-utils vim-tiny nano-tiny wget ca-certificates rsync \
        passwd libnss-wrapper \
        paraview

    echo "🔹 Setting up Python venv..."
    python3 -m venv /openfoam/venv
    /openfoam/venv/bin/pip install --no-cache-dir --upgrade pip
    /openfoam/venv/bin/pip install --no-cache-dir -r /openfoam/requirements.txt

    echo "🔹 Installing OpenFOAM..."
    wget -q -O - https://dl.openfoam.com/add-debian-repo.sh | bash
    apt-get update
    apt-get -y install --no-install-recommends \
        openfoam2406 openfoam2406-dev

    echo "🔹 Cleaning APT cache..."
    rm -rf /var/lib/apt/lists/*

    echo "🔹 Finalizing permissions..."
    /bin/sh /openfoam/assets/post-install.sh -fix-perms -no-sudo

%environment
    export PATH=/usr/lib/openfoam/openfoam2406/platforms/linux64GccDPInt32Opt/bin:/usr/lib/openfoam/openfoam2406/bin:/usr/lib/openfoam/openfoam2406/wmake:$PATH
    export LD_LIBRARY_PATH=/usr/lib/openfoam/openfoam2406/platforms/linux64GccDPInt32Opt/lib:$LD_LIBRARY_PATH

%runscript
    echo "🔹 Sourcing Python venv..."
    source /openfoam/venv/bin/activate
    exec "$@"

%labels
    Author OpenCFD Ltd.
    Description OpenFOAM 2406 with Python venv + Paraview, for cloud or HPC use
# ---------------------------------------------------------------------------

