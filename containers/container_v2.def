Bootstrap: docker
From: ubuntu:22.04
Stage: build

%post
    # Define functions
    check_and_install_apt_package () {
        if ! dpkg -s "$1" >/dev/null 2>&1; then
            echo "Installing $1..."
            apt-get install -y "$1"
        else
            echo "$1 already installed, skipping."
        fi
    }

    check_and_install_conda_package () {
        local pkg=$1
        if ! conda list -n mclaren-newenv | grep -q "^${pkg} "; then
            echo "Installing $pkg..."
            conda install -n mclaren-newenv "$pkg"
        else
            echo "$pkg already installed in conda env."
        fi
    }

    ###########################
    # Essential System Packages
    ###########################
    apt-get update && apt-get install -y software-properties-common

    for pkg in \
        mpich \
        libmpich-dev \
        netcat \
        git \
        vim \
        gcc \
        g++ \
        build-essential \
        cmake \
        wget \
        bzip2 \
        libgl1 \
        libxrender1 \
        libsm6 \
        libxext6 \
        curl \
        ca-certificates \
        gnupg \
        lsb-release; do
        check_and_install_apt_package "$pkg"
    done

    ###########################
    # OpenFOAM (only if not yet installed)
    ###########################
    if [ ! -d "/opt/openfoam10" ]; then
        echo "Installing OpenFOAM10..."
        wget -O - https://dl.openfoam.org/gpg.key | apt-key add -
        add-apt-repository http://dl.openfoam.org/ubuntu
        apt-get update
        apt-get install -y openfoam10
        echo "source /opt/openfoam10/etc/bashrc" >> /etc/bash.bashrc
    else
        echo "OpenFOAM already installed, skipping."
    fi

    ###########################
    # Install Anaconda if not yet installed
    ###########################
    if [ ! -d "/opt/conda" ]; then
        echo "Installing Anaconda..."
        mkdir -p /opt/download
        cd /opt/download
        wget https://repo.anaconda.com/archive/Anaconda3-2024.10-1-Linux-x86_64.sh
        chmod +x Anaconda3-2024.10-1-Linux-x86_64.sh
        ./Anaconda3-2024.10-1-Linux-x86_64.sh -b -p /opt/conda
    else
        echo "Anaconda already installed, skipping."
    fi

    ###########################
    # Set up conda and create environment
    ###########################
    export PATH="/opt/conda/bin:$PATH"
    . /opt/conda/etc/profile.d/conda.sh
    conda config --set always_yes yes --set changeps1 no
    conda update -n base -c defaults conda

    if ! conda info --envs | grep -q "mclaren-newenv"; then
        echo "Creating Conda environment mclaren-newenv..."
        conda create -n mclaren-newenv -c conda-forge \
            mpich \
            mpi4py \
            "hdf5=*=mpi*" \
            "h5py=*=mpi*" \
            numpy \
            scipy \
            pyvista \
            tqdm \
            pytest \
            pyyaml \
            untangle \
            meshio \
            pandas
    else
        echo "Conda environment mclaren-newenv already exists, skipping."
    fi

%environment
    export PATH="/opt/conda/bin:$PATH"
    . /opt/conda/etc/profile.d/conda.sh
    conda activate mclaren-newenv
    export PYTHONNOUSERSITE=1  # Prevent loading ~/.local/lib/*
    export CC=$(which gcc)
    export CXX=$(which g++)
    source /opt/openfoam10/etc/bashrc

%runscript
    exec python3 "$@"

