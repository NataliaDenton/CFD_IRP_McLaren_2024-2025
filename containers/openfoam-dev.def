#
# Create OpenFOAM '-dev' image using Ubuntu 22.04.
#
# Example build:
#     apptainer build --fakeroot openfoam_dev_2406.sif openfoam-dev.def
#
# ---------------------------------------------------------------------------
Bootstrap: docker
From: ubuntu:22.04

%files
    openfoam-files.rc/* /openfoam/
    requirements.txt /openfoam/requirements.txt

%post
    DEBIAN_FRONTEND=noninteractive

    echo "🔹 Updating APT sources..."
    apt-get update

    echo "🔹 Installing system dependencies..."
    apt-get -y install --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        apt-utils vim-tiny nano-tiny wget ca-certificates rsync \
        passwd libnss-wrapper

    echo "🔹 Setting up Python virtual environment..."
    python3 -m venv /openfoam/venv
    /openfoam/venv/bin/pip install --no-cache-dir --upgrade pip

    echo "🔹 Installing Python packages..."
    /openfoam/venv/bin/pip install --no-cache-dir -r /openfoam/requirements.txt

    echo "🔹 Installing OpenFOAM..."
    wget -q -O - https://dl.openfoam.com/add-debian-repo.sh | bash
    apt-get update
    apt-get -y install --no-install-recommends openfoam2406-dev
    rm -rf /var/lib/apt/lists/*

    echo "🔹 Finalizing permissions..."
    /bin/sh /openfoam/assets/post-install.sh -fix-perms -no-sudo

%runscript
    echo "🔹 Sourcing OpenFOAM and Python venv..."
    source /openfoam/venv/bin/activate
    source /openfoam/bash.rc
    exec "$@"

%labels
    Author OpenCFD Ltd.
    Description OpenFOAM 2406 with Python venv for cloud deployment

# ---------------------------------------------------------------------------
