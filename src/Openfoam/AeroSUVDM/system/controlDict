FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     snappyHexMesh;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5;
deltaT          1e-2;
writeControl    timeStep;
writeInterval   50;
purgeWrite      100;
writeFormat     ascii;
writePrecision  6;
writeCompression uncompressed;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.5;

functions
{

    fieldAverage
    {
        type                fieldAverage;
        functionObjectLibs  ("libfieldFunctionObjects.so");
        enabled             true;
        outputControl       timeStep;
        outputInterval      50;

        timeStart           3;
        timeEnd             5;

        fields
        (
            U
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            p
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
        );
    }
    // Continuity error diagnostics
    continuityErrors
    {
        type            continuityError;
        functionObjectLibs ("libutilityFunctionObjects.so");
        enabled         true;
        outputControl   timeStep;
        outputInterval  50;
        cumulative      true;
    }

    // Compute drag and lift coefficients

    forceCoeffs
    {
        type                forceCoeffs;
        functionObjectLibs  ("libforces.so");
        enabled             true;
        outputControl       timeStep;
        outputInterval      50;
        patches             (Geometry);
        rho                 rhoInf;
        rhoInf              1.225;               // freestream density [kg/m^3]
        magUInf             30.0;
        lRef                1.0;
        Aref                2.0;
        CofR                (0.0 0.0 0.0);
        liftDir             (0.0 1.0 0.0);
        dragDir             (1.0 0.0 0.0);
        pitchAxis           (0.0 0.0 1.0);
    }

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        patches             (Geometry);
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   50;  // adjust as needed
        log             true;
        timeStart       0;
    }
}
