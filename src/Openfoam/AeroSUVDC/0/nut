FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0.0908;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.0908;
    }

    outlet
    {
        type            calculated;
        value           uniform 0.0908;
    }

    bottom
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    top
    {
        type            symmetryPlane;
    }

    front
    {
        type            symmetryPlane;
    }

    back
    {
        type            symmetryPlane;
    }

    Geometry
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

}
