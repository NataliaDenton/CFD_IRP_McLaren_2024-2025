FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0]; // kinematic viscosity dimensions

internalField   uniform 1e-5; // initial guess for turbulent viscosity, tune as needed

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-5;
    }


    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    Geometry
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}

